# ============ NUBSEN — contoh variabel lingkungan ============
# Salin menjadi .env (lokal) atau isikan di dashboard hosting.
# .env TIDAK boleh di-commit (sudah masuk .gitignore).

# ---------- FRONTEND (Vite / Vercel) ----------
# Kosong = pakai path relatif '/api/...' (dev lokal, diproxy Vite ke :9091).
# Di produksi: isi URL backend, mis. https://nubsen-backend.onrender.com
VITE_BACKEND_URL=

# ---------- BACKEND (Express / Render) ----------
PORT=9091
NODE_ENV=production
NODE_VERSION=24

# Batasi CORS (opsional). Kosong = semua origin diizinkan.
# Contoh: https://nubsen.vercel.app,http://localhost:9090
CORS_ORIGINS=

# Lokasi penyimpanan (untuk hosting dengan persistent disk).
# Kosong = default: server/data dan server/uploads
DATA_DIR=
UPLOAD_DIR=
